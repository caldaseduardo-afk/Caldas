{
  "name": "atendente-ia",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint scripts && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @atendente/database generate",
    "db:validate": "pnpm --filter @atendente/database db:validate",
    "db:migrate": "pnpm --filter @atendente/database db:migrate",
    "db:migrate:dev": "pnpm --filter @atendente/database db:migrate:dev",
    "db:seed": "pnpm --filter @atendente/database db:seed",
    "db:test": "node scripts/test-database.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.0",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
