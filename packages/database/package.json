{
  "name": "@atendente/database",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.test.json",
    "build": "pnpm --filter @atendente/domain build && prisma generate && tsc",
    "generate": "prisma generate",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/unit.test.js .test-dist/test/tenant-credentials.test.js",
    "test:integration": "prisma generate && tsc -p tsconfig.test.json && node --test .test-dist/test/integration.test.js",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "pnpm build && prisma db seed",
    "db:seed:rbac": "pnpm build && node --env-file-if-exists=../../.env dist/seed-rbac.js",
    "whatsapp:configure": "pnpm build && node --env-file-if-exists=../../.env dist/configure-whatsapp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@atendente/domain": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "7.10.0"
  }
}
