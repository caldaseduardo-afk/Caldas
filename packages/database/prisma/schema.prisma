generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  subscription                 TenantSubscription?
  calendarIntegration           CalendarIntegration?
  calendarSyncAttempts          CalendarSyncAttempt[]
  notificationAttempts         NotificationAttempt[]
  aiConfiguration              AIConfiguration?
  aiConfigurationVersions      AIConfigurationVersion[]
  knowledgeArticles            KnowledgeArticle[]
  knowledgeArticleVersions     KnowledgeArticleVersion[]
  schedulingWorkflows          SchedulingWorkflow[]
  schedulingSlotOptions        SchedulingSlotOption[]
  schedulingAppointmentOptions SchedulingAppointmentOption[]
  aiProcessingRuns             AIProcessingRun[]
  conversationEngineLeases     ConversationEngineLease[]
  toolExecutions               ToolExecution[]
  aiUsages                     AIUsage[]
  integrations                 Integration[]
  humanSlaRule                 HumanSlaRule?
  humanSlaCycles               HumanSlaCycle[]
  humanSlaJobs                 HumanSlaJob[]
  conversations                Conversation[]
  messages                     Message[]
  notificationRules            NotificationRule[]
  appointments                 Appointment[]
  appointmentHolds             AppointmentHold[]
  availabilityRules            AvailabilityRule[]
  scheduleExceptions           ScheduleException[]
  providers                    Provider[]
  providerServices             ProviderService[]
  providerUnits                ProviderUnit[]
  specialties                  Specialty[]
  services                     Service[]
  id                           String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                         String
  status                       String
  timezone                     String
  createdAt                    DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  units                        Unit[]
  memberships                  UserTenant[]
  authEvents                   AuthEvent[]
  contacts                     Contact[]
  contactChannels              ContactChannel[]
  patients                     Patient[]
  patientLinks                 ContactPatient[]

  @@index([status, name, id], map: "tenants_platform_status_name_idx")
  @@map("tenants")
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  GRACE
  SUSPENDED
  CANCELLED
}

model TenantSubscription {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String             @unique @map("tenant_id") @db.Uuid
  planCode            String             @default("BASIC") @map("plan_code") @db.VarChar(32)
  status              SubscriptionStatus @default(ACTIVE)
  currentPeriodStart  DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd    DateTime           @map("current_period_end") @db.Timestamptz(3)
  graceUntil          DateTime?          @map("grace_until") @db.Timestamptz(3)
  scheduledPlanCode   String?            @map("scheduled_plan_code") @db.VarChar(32)
  overrides           Json               @default("{}") @db.JsonB
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([status, currentPeriodEnd])
  @@index([tenantId, currentPeriodStart])
  @@map("tenant_subscriptions")
}

model Unit {
  knowledgeArticles     KnowledgeArticle[]
  schedulingWorkflows   SchedulingWorkflow[]
  schedulingSlotOptions SchedulingSlotOption[]
  appointments          Appointment[]
  appointmentHolds      AppointmentHold[]
  availabilityRules     AvailabilityRule[]
  scheduleExceptions    ScheduleException[]
  providers             ProviderUnit[]
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  name                  String
  address               String
  timezoneOverride      String?                @map("timezone_override")
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@map("units")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

