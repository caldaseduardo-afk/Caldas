  PAYMENT_INFORMATION
  APPOINTMENT_PREPARATION
}

model AIConfiguration {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                   @unique @map("tenant_id") @db.Uuid
  activeVersionId String?                  @map("active_version_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions        AIConfigurationVersion[] @relation("AIConfigurationVersions")
  activeVersion   AIConfigurationVersion?  @relation("AIConfigurationActiveVersion", fields: [tenantId, activeVersionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, activeVersionId])
  @@map("ai_configurations")
}

model AIConfigurationVersion {
  id                        String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                  String                       @map("tenant_id") @db.Uuid
  configurationId           String                       @map("configuration_id") @db.Uuid
  versionNumber             Int                          @map("version_number")
  status                    AIConfigurationVersionStatus @default(DRAFT)
  assistantName             String                       @map("assistant_name") @db.VarChar(80)
  tone                      AITone                       @default(PROFESSIONAL)
  customTone                String?                      @map("custom_tone") @db.VarChar(500)
  greeting                  String                       @db.VarChar(500)
  systemInstructions        String                       @map("system_instructions") @db.VarChar(4000)
  allowedContent            AIContentTopic[]             @map("allowed_content")
  enabledCapabilities       AICapability[]               @map("enabled_capabilities")
  knowledgeEnabled          Boolean                      @default(true) @map("knowledge_enabled")
  handoffPaymentNegotiation Boolean                      @default(true) @map("handoff_payment_negotiation")
  handoffKnowledgeMiss      Boolean                      @default(true) @map("handoff_knowledge_miss")
  model                     String                       @db.VarChar(128)
  temperature               Decimal?                     @db.Decimal(3, 2)
  maxOutputTokens           Int                          @map("max_output_tokens")
  confidenceThreshold       Decimal                      @map("confidence_threshold") @db.Decimal(3, 2)
  basedOnVersionId          String?                      @map("based_on_version_id") @db.Uuid
  createdByUserId           String                       @map("created_by_user_id") @db.Uuid
  updatedByUserId           String                       @map("updated_by_user_id") @db.Uuid
  publishedByUserId         String?                      @map("published_by_user_id") @db.Uuid
  publishedAt               DateTime?                    @map("published_at") @db.Timestamptz(3)
  createdAt                 DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                    Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  configuration             AIConfiguration              @relation("AIConfigurationVersions", fields: [tenantId, configurationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  activeFor                 AIConfiguration[]            @relation("AIConfigurationActiveVersion")
  basedOn                   AIConfigurationVersion?      @relation("AIConfigurationVersionLineage", fields: [tenantId, basedOnVersionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  derivedVersions           AIConfigurationVersion[]     @relation("AIConfigurationVersionLineage")
  createdBy                 User                         @relation("AIConfigVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy                 User                         @relation("AIConfigVersionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publishedBy               User?                        @relation("AIConfigVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  processingRuns            AIProcessingRun[]
  usages                    AIUsage[]

  @@unique([tenantId, id])
  @@unique([tenantId, configurationId, versionNumber])
  @@index([tenantId, configurationId, status])
  @@index([tenantId, publishedAt])
  @@index([tenantId, basedOnVersionId])
  @@map("ai_configuration_versions")
}


// Global capability: never inferred from UserTenant.role.
model PlatformAdmin {
  userId String @id @map("user_id") @db.Uuid
  active Boolean @default(true)
  encryptedSecret String? @map("encrypted_secret")
  enrolledAt DateTime? @map("enrolled_at") @db.Timestamptz(3)
  lastStep BigInt @default(-1) @map("last_step")
  inviteHash String? @unique @map("invite_hash") @db.Char(64)
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@map("platform_admins")
}
model PlatformSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  verifiedAt DateTime @default(now()) @map("verified_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([userId, expiresAt])
  @@map("platform_sessions")
}
