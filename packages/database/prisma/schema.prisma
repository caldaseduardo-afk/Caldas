  SPECIALTY_CREATED
  SPECIALTY_UPDATED
  SERVICE_CREATED
  SERVICE_UPDATED
  USER_CREATED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGIN_THROTTLED
  LOGOUT
  TENANT_SELECTED
  TENANT_MEMBERSHIP_GRANTED
  TENANT_CREATED
  TENANT_UPDATED
  TENANT_DEACTIVATED
  UNIT_CREATED
  UNIT_UPDATED
  UNIT_DEACTIVATED
  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_CHANNEL_CREATED
  CONTACT_CHANNEL_UPDATED
  PATIENT_CREATED
  PATIENT_UPDATED
  CONTACT_PATIENT_CREATED
  CONTACT_PATIENT_UPDATED
  CONTACT_PATIENT_REVOKED
}

model User {
  platformAdmin PlatformAdmin?
  platformSessions PlatformSession[]
  id                               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                            String                    @unique
  name                             String
  passwordHash                     String                    @map("password_hash")
  mfaEnabled                       Boolean                   @default(false) @map("mfa_enabled")
  mfaRequired                      Boolean                   @default(false) @map("mfa_required")
  status                           UserStatus                @default(ACTIVE)
  createdAt                        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                        DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions                         AuthSession[]
  events                           AuthEvent[]
  memberships                      UserTenant[]
  knowledgeArticlesCreated         KnowledgeArticle[]        @relation("KnowledgeArticleCreatedBy")
  knowledgeArticlesUpdated         KnowledgeArticle[]        @relation("KnowledgeArticleUpdatedBy")
  knowledgeVersionsCreated         KnowledgeArticleVersion[] @relation("KnowledgeVersionCreatedBy")
  knowledgeVersionsUpdated         KnowledgeArticleVersion[] @relation("KnowledgeVersionUpdatedBy")
  knowledgeVersionsPublished       KnowledgeArticleVersion[] @relation("KnowledgeVersionPublishedBy")
  aiConfigurationVersionsCreated   AIConfigurationVersion[]  @relation("AIConfigVersionCreatedBy")
  aiConfigurationVersionsUpdated   AIConfigurationVersion[]  @relation("AIConfigVersionUpdatedBy")
  aiConfigurationVersionsPublished AIConfigurationVersion[]  @relation("AIConfigVersionPublishedBy")

  @@map("users")
}

model AuthSession {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activeTenantId String?     @map("active_tenant_id") @db.Uuid
  membership     UserTenant? @relation(fields: [userId, activeTenantId], references: [userId, tenantId], onDelete: Cascade, onUpdate: Cascade)
  tokenHash      String      @unique @map("token_hash") @db.Char(64)
  userId         String      @map("user_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(3)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, activeTenantId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

enum AuditActorType {
  USER
  AI
  SYSTEM
  AUTOMATION
  INTEGRATION
  IMPORT
}

enum AuditSource {
  WEB
  API
  WHATSAPP
  AI_ENGINE
  WORKER
  GOOGLE_CALENDAR
  SYSTEM
  IMPORT
}

enum AuditResourceType {
  TENANT
  UNIT
  USER
  CONTACT
  CONTACT_CHANNEL
  PATIENT
  CONTACT_PATIENT
  SPECIALTY
  SERVICE
  PROVIDER
  AVAILABILITY_RULE
  SCHEDULE_EXCEPTION
  APPOINTMENT_HOLD
  APPOINTMENT
  CONVERSATION
  NOTIFICATION_RULE
  HUMAN_SLA_RULE
  KNOWLEDGE_ARTICLE
  AI_CONFIGURATION
  INTEGRATION
}

model AuthEvent {
  isBusiness Boolean @default(false) @map("is_business")
  actorType AuditActorType @default(SYSTEM) @map("actor_type")
  actorReferenceId String? @map("actor_reference_id") @db.VarChar(128)
  source AuditSource @default(SYSTEM)
  resourceType AuditResourceType? @map("resource_type")
  previousValues Json? @map("previous_values")
  newValues Json? @map("new_values")
  metadata Json?
  correlationId String? @map("correlation_id") @db.Uuid
  resourceId String?       @map("resource_id") @db.Uuid
  changes    Json?
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?       @map("user_id") @db.Uuid
  tenantId   String?       @map("tenant_id") @db.Uuid
  tenant     Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  type       AuthEventType
  ipHash     String?       @map("ip_hash") @db.Char(64)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User?         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, resourceId, type, createdAt, id])
  @@index([tenantId, type])
  @@index([tenantId, userId])
  @@index([tenantId, source])
  @@index([correlationId])
  @@map("auth_events")
}

model AuthThrottle {
  key       String   @id @db.Char(64)
  attempts  Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_throttles")
}

model UserTenant {
  assignedConversations  Conversation[]
  sentMessages           Message[]
  appointments           Appointment[]
  createdHolds           AppointmentHold[]
  userId                 String            @map("user_id") @db.Uuid
  tenantId               String            @map("tenant_id") @db.Uuid
  role                   String
  roleDefinition         Role              @relation(fields: [role], references: [name], onDelete: Restrict, onUpdate: Restrict)
  active                 Boolean           @default(true)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions               AuthSession[]
  authorizedPatientLinks ContactPatient[]  @relation("patient_link_authorizer")
  revokedPatientLinks    ContactPatient[]  @relation("patient_link_revoker")

  @@id([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

model Role {
  name        String           @id
  enabled     Boolean          @default(false)
  memberships UserTenant[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  name  String           @id
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleName       String     @map("role_name")
  permissionName String     @map("permission_name")
  role           Role       @relation(fields: [roleName], references: [name], onDelete: Cascade, onUpdate: Restrict)
  permission     Permission @relation(fields: [permissionName], references: [name], onDelete: Cascade, onUpdate: Restrict)

  @@id([roleName, permissionName])
  @@map("role_permissions")
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum ContactChannelType {
  PHONE
  WHATSAPP
}

model Contact {
  schedulingWorkflows SchedulingWorkflow[]
  toolExecutions      ToolExecution[]
  conversations       Conversation[]
  appointments        Appointment[]
  appointmentHolds    AppointmentHold[]
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  displayName         String               @map("display_name")
  status              ContactStatus        @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  channels            ContactChannel[]
  patientLinks        ContactPatient[]

  @@unique([tenantId, id])
  @@map("contacts")
}

model ContactChannel {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  contactId          String             @map("contact_id") @db.Uuid
  type               ContactChannelType
  address            String             @db.VarChar(16)
  providerExternalId String?            @map("provider_external_id") @db.VarChar(200)
  primary            Boolean            @default(false)
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contact            Contact            @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, type, address], map: "contact_channels_tenant_type_address_key")
  @@unique([tenantId, type, providerExternalId], map: "contact_channels_tenant_type_external_key")
  @@index([tenantId, address])
  @@index([tenantId, contactId])
  @@map("contact_channels")
}

enum RelationshipType {
  SELF
  MOTHER
  FATHER
  SON_DAUGHTER
  SPOUSE
  LEGAL_GUARDIAN
  CAREGIVER
  SECRETARY
  OTHER
}

enum RelationshipStatus {
  DECLARED
  VERIFIED
  REVOKED
}

enum PatientAuthorizationLevel {
  FULL
  SCHEDULING_ONLY
  NO_ACCESS
}

model Patient {
  schedulingWorkflows SchedulingWorkflow[]
  toolExecutions      ToolExecution[]
  conversations       Conversation[]
  appointments        Appointment[]
  appointmentHolds    AppointmentHold[]
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  name                String
  birthDate           DateTime             @map("birth_date") @db.Date
  document            String?
  healthPlan          String?              @map("health_plan")
  paymentPreference   String?              @map("payment_preference")
  notes               String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contacts            ContactPatient[]

  @@unique([tenantId, id])
  @@map("patients")
}

model ContactPatient {
  activeConversations Conversation[]
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                    @map("tenant_id") @db.Uuid
  contactId           String                    @map("contact_id") @db.Uuid
  patientId           String                    @map("patient_id") @db.Uuid
  relationshipType    RelationshipType          @map("relationship_type")
  relationshipStatus  RelationshipStatus        @default(DECLARED) @map("relationship_status")
  authorizationLevel  PatientAuthorizationLevel @default(NO_ACCESS) @map("authorization_level")
  isPrimaryContact    Boolean                   @default(false) @map("is_primary_contact")
  legalRepresentative Boolean                   @default(false) @map("legal_representative")
  active              Boolean                   @default(true)
  authorizedAt        DateTime?                 @map("authorized_at") @db.Timestamptz(3)
  authorizedBy        String?                   @map("authorized_by") @db.Uuid
  revokedAt           DateTime?                 @map("revoked_at") @db.Timestamptz(3)
  revokedBy           String?                   @map("revoked_by") @db.Uuid
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contact             Contact                   @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  patient             Patient                   @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  authorizer          UserTenant?               @relation("patient_link_authorizer", fields: [authorizedBy, tenantId], references: [userId, tenantId], onDelete: Restrict, onUpdate: Restrict)
  revoker             UserTenant?               @relation("patient_link_revoker", fields: [revokedBy, tenantId], references: [userId, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, contactId, patientId])
  @@index([tenantId, patientId, active])
  @@index([tenantId, contactId, active])
  @@map("contact_patients")
}

model Specialty {
  schedulingWorkflows SchedulingWorkflow[]
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  name                String               @db.VarChar(200)
  description         String?              @db.VarChar(2000)
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  services            Service[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("specialties")
}

model Service {
  schedulingWorkflows   SchedulingWorkflow[]
  schedulingSlotOptions SchedulingSlotOption[]
  appointments          Appointment[]
  appointmentHolds      AppointmentHold[]
  providers             ProviderService[]
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  specialtyId           String                 @map("specialty_id") @db.Uuid
  name                  String                 @db.VarChar(200)
  description           String?                @db.VarChar(2000)
  durationMinutes       Int                    @map("duration_minutes")
  bufferBeforeMinutes   Int                    @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes    Int                    @default(0) @map("buffer_after_minutes")
  price                 Decimal?               @db.Decimal(12, 2)
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  specialty             Specialty              @relation(fields: [tenantId, specialtyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, specialtyId, name])
  @@index([tenantId, active])
  @@index([tenantId, specialtyId, active])
  @@map("services")
}

model Provider {
  schedulingWorkflows   SchedulingWorkflow[]
  schedulingSlotOptions SchedulingSlotOption[]
  appointments          Appointment[]
  appointmentHolds      AppointmentHold[]
  availabilityRules     AvailabilityRule[]
  scheduleExceptions    ScheduleException[]
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  name                  String                 @db.VarChar(200)
  professionalType      String                 @map("professional_type") @db.VarChar(80)
  registrationNumber    String?                @map("registration_number") @db.VarChar(120)
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  services              ProviderService[]
  units                 ProviderUnit[]

  @@unique([tenantId, id])
  @@index([tenantId, active])
  @@map("providers")
}

model ProviderService {
  appointments            Appointment[]
  appointmentHolds        AppointmentHold[]
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String            @map("tenant_id") @db.Uuid
  providerId              String            @map("provider_id") @db.Uuid
  serviceId               String            @map("service_id") @db.Uuid
  durationOverrideMinutes Int?              @map("duration_override_minutes")
  priceOverride           Decimal?          @map("price_override") @db.Decimal(12, 2)
  active                  Boolean           @default(true)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provider                Provider          @relation(fields: [tenantId, providerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  service                 Service           @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, providerId, serviceId])
  @@index([tenantId, providerId, active])
  @@index([tenantId, serviceId, active])
  @@map("provider_services")
}

model ProviderUnit {
  appointments       Appointment[]
  appointmentHolds   AppointmentHold[]
  availabilityRules  AvailabilityRule[]
  scheduleExceptions ScheduleException[]
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  providerId         String              @map("provider_id") @db.Uuid
  unitId             String              @map("unit_id") @db.Uuid
  active             Boolean             @default(true)
