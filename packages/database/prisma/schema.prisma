  PLAN_UPGRADED
  PLAN_DOWNGRADED
  PLAN_OVERRIDE_CHANGED
  SUBSCRIPTION_STATUS_CHANGED
  GRACE_STARTED
  GRACE_ENDED
  PLATFORM_ADMIN_GRANTED
  PLATFORM_ADMIN_REVOKED
  PLATFORM_MFA_ENROLLED
  PLATFORM_LOGIN_SUCCEEDED
  PLATFORM_LOGIN_FAILED
  PLATFORM_LOGOUT
  PLATFORM_TENANT_VIEWED
  CALENDAR_INTEGRATION_CONFIGURED
  CALENDAR_CONNECTION_TESTED
  CALENDAR_SYNC_SUCCEEDED
  CALENDAR_SYNC_FAILED
  AI_CONFIG_VERSION_CREATED
  AI_CONFIG_VERSION_UPDATED
  AI_CONFIG_PUBLISHED
  AI_CONFIG_RESTORED
  AI_CONFIG_SIMULATED
  KNOWLEDGE_ARTICLE_CREATED
  KNOWLEDGE_ARTICLE_UPDATED
  KNOWLEDGE_ARTICLE_PUBLISHED
  KNOWLEDGE_ARTICLE_INACTIVATED
  SCHEDULING_WORKFLOW_STARTED
  SCHEDULING_WORKFLOW_UPDATED
  SCHEDULING_WORKFLOW_COMPLETED
  SCHEDULING_WORKFLOW_ABANDONED
  SCHEDULING_WORKFLOW_HANDOFF
  CONVERSATION_ENGINE_STARTED
  CONVERSATION_ENGINE_COMPLETED
  CONVERSATION_ENGINE_FAILED
  CONVERSATION_ENGINE_HANDOFF
  INTEGRATION_CONFIGURED
  MESSAGE_SEND_REQUESTED
  MESSAGE_SEND_SUCCEEDED
  MESSAGE_SEND_FAILED
  HUMAN_SLA_RULE_CREATED
  HUMAN_SLA_RULE_UPDATED
  HUMAN_SLA_FIRST_ALERT
  HUMAN_SLA_SECOND_ALERT
  HUMAN_SLA_EXTERNAL_ALERT_REQUIRED
  HUMAN_SLA_CLEARED
  HUMAN_HANDOFF_REQUESTED
  CONVERSATION_CLAIMED
  CONVERSATION_TRANSFERRED
  CONVERSATION_RETURNED_TO_AI
  CONVERSATION_RESOLVED
  CONVERSATION_CREATED
  CONVERSATION_UPDATED
  CONVERSATION_STATUS_CHANGED
  MESSAGE_CREATED
  MESSAGE_RECEIPT_UPDATED
  NOTIFICATION_RULE_CREATED
  NOTIFICATION_RULE_UPDATED
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CHECKED_IN
  APPOINTMENT_COMPLETED
  APPOINTMENT_NO_SHOW
  HOLD_CREATED
  HOLD_RELEASED
  HOLD_EXPIRED
