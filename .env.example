# Application
NODE_ENV=development

# Database
POSTGRES_USER=atendente
POSTGRES_DB=atendente_ia
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
# Preencha com a mesma senha de POSTGRES_PASSWORD (URL-encoded se necessário).
DATABASE_URL=postgresql://atendente:SUA_SENHA@localhost:5432/atendente_ia

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Auth
AUTH_SECRET=
AUTH_ORIGIN=http://localhost:3000

# OpenAI
OPENAI_API_KEY=

# WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CALENDAR_RECONCILIATION_HORIZON_DAYS=180

# Storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# HOLD (tempo de vida em segundos; varredura do worker em milissegundos)
HOLD_TTL_SECONDS=300
HOLD_SWEEP_INTERVAL_MS=30000

# TASK-028: automações assíncronas; PostgreSQL permanece a fonte de verdade.
WORKER_CONCURRENCY=4
NOTIFICATION_RECONCILIATION_HORIZON_DAYS=30

# URL interna da API para o proxy Next (nunca enviada ao navegador).
API_INTERNAL_URL=http://localhost:3001

# TASK-019: API recebe eventos; worker agenda/processa SLA.
REDIS_PORT=6379

# TASK-020: one Meta app, multiple tenant integrations. No credentials in database.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Administrative provisioning only; never used to route webhook requests.
WHATSAPP_TENANT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_CREDENTIALS_REFERENCE=
WHATSAPP_INTEGRATION_STATUS=
# Reference may name another WHATSAPP_ACCESS_TOKEN_<ALIAS> injected in worker environment.
WHATSAPP_ACCESS_TOKEN_DEFAULT=

# TASK-021: inferência interna, sem acionamento automático. Ausência falha só no uso de IA.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ALLOWED_MODELS=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_OUTPUT_TOKENS=1024
OPENAI_MAX_RETRIES=1
OPENAI_RETRY_DELAY_MS=250
OPENAI_MAX_RETRY_DELAY_MS=2000
# Opcional: preencher somente para modelos que suportem temperature.
OPENAI_TEMPERATURE=

# TASK-022: orçamento de tools por turno interno (sem endpoint público).
TOOL_CALLS_PER_TURN=8
TOOL_TIMEOUT_MS=5000
TOOL_TURN_TIMEOUT_MS=30000

# TASK-023: processamento assíncrono. Ative somente com Redis e OpenAI configurados.
CONVERSATION_ENGINE_ENABLED=false
CONVERSATION_ENGINE_HISTORY_LIMIT=20
CONVERSATION_ENGINE_MAX_ITERATIONS=5
CONVERSATION_ENGINE_MAX_TOOL_CALLS=8
CONVERSATION_ENGINE_TIMEOUT_MS=30000
CONVERSATION_ENGINE_MIN_CONFIDENCE=0.6

# TASK-024: estado conversacional e validade das opções (HOLD mantém TTL próprio).
SCHEDULING_WORKFLOW_TTL_HOURS=24
SCHEDULING_OPTION_TTL_MINUTES=15
