{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@atendente/database#build": {
      "outputs": ["dist/**", "src/generated/**"]
    },
    "@atendente/database#typecheck": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "@atendente/database#test": {
      "cache": false,
      "dependsOn": ["build"]
    }
  },
  "globalDependencies": [
    "eslint.config.mjs",
    "packages/config/*.json",
    "packages/config/*.mjs"
  ],
  "globalEnv": ["API_INTERNAL_URL"]
}
